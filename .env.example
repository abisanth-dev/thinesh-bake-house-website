# Supabase (server-side, used by server.ts — service role key bypasses RLS, keep secret)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (client-side, exposed to the browser bundle — anon key is safe to expose, RLS protects data)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# WooCommerce REST API credentials (optional bootstrap defaults; can also be set from the Admin panel)
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Anthropic API key for the chat assistant (create one at https://platform.claude.com)
ANTHROPIC_API_KEY=

# App URL
APP_URL=
